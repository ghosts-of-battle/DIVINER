# pacbot configuration.
#
# On a Pelican server these are the egg's variables and this file is not used.
# For running the bot on your own machine, copy it to .env (which is gitignored)
# and load it however you prefer.
#
# Every name is prefixed PACBOT_ so nothing here can collide with the
# SERVER_MEMORY / SERVER_IP / SERVER_PORT that the panel injects into every
# container.

# --- required ---------------------------------------------------------------
# The bot refuses to start without these three, naming the one that is missing.
PACBOT_DISCORD_TOKEN=
PACBOT_GUILD_ID=
# Give the bot its OWN Atlas user, not the game server's: separate credentials
# can be revoked on their own, and Atlas's audit log can then tell a bot write
# from a game write. Read-only until staff commands are signed off.
PACBOT_MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/

# --- where the data is ------------------------------------------------------
PACBOT_MONGO_DB=ghostd
PACBOT_MONGO_COLLECTION=pac
# The unit id, which is also the document prefix. Point this at a test unit
# (for example frameworktest) to work against a completely separate set of
# documents in the same database.
PACBOT_UNIT_ID=framework
# Stamped onto every record the bot writes, so a merged store says who did it.
PACBOT_SERVER_ID=discord

# --- who may do what --------------------------------------------------------
# Comma-separated Discord role ids. With none set, every staff command refuses.
PACBOT_STAFF_ROLE_IDS=
# Leave empty to let the whole guild use the lookup commands.
PACBOT_COMMAND_ROLE_IDS=
# An escape hatch for a mistyped role id.
PACBOT_OWNER_IDS=
# Also require the caller's linked Steam id to be in the unit's admins section,
# so the Discord role and the in-game admin list cannot drift apart. Turn this
# on once linking is done.
PACBOT_REQUIRE_PAC_ADMIN=false

# --- channels ---------------------------------------------------------------
# Any of these left empty simply switches that feature off.
PACBOT_ANNOUNCE_CHANNEL_ID=
PACBOT_OPORD_CHANNEL_ID=
PACBOT_STAFF_LOG_CHANNEL_ID=
PACBOT_LINK_REQUEST_CHANNEL_ID=
# The staff log echoes every write. Notes are echoed as a character count
# unless you turn this on, because the log channel is usually wider than the
# people who should read a note.
PACBOT_STAFF_LOG_NOTE_TEXT=false

# --- writing ----------------------------------------------------------------
# The kill switch. Leave this false until the staff commands are proven.
PACBOT_WRITES_ENABLED=true
# The game replaces the whole roster document from its own memory whenever it
# saves, so an edit made while a server is live is erased at its next save. The
# bot warns; set this to true to make it refuse instead.
PACBOT_REFUSE_WRITES_WHEN_LIVE=false
PACBOT_LIVE_WINDOW_MINUTES=20
PACBOT_IDLE_MINUTES=30

# --- announcements ----------------------------------------------------------
PACBOT_WATCH_ENABLED=true
# The roster only changes on SAVE, logon, logoff and mission end, so polling
# faster than this buys nothing and costs Atlas connections.
PACBOT_POLL_SECONDS=60
PACBOT_ANNOUNCE_TYPES=rank,award
PACBOT_ANNOUNCE_MAX_PER_TICK=5

# --- odds and ends ----------------------------------------------------------
PACBOT_CACHE_SECONDS=20
# The bot's own cursor document. Its id sits outside the names and prefixes the
# mod scans, so the game never sees it.
PACBOT_STATE_DOC_ID=
PACBOT_ATTENDANCE_THRESHOLD=60
PACBOT_EMBED_COLOR=0x39FF7A
PACBOT_LOG_LEVEL=INFO

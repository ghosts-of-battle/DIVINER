<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The store service: one JSON document per unit, in MongoDB (or a folder
       of files for testing) - chosen in appsettings.json.
       Build:  dotnet publish -c Release -o out    Run:  dotnet pacdb-service.dll -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pacdb-service</AssemblyName>
    <RootNamespace>GhostD.PacDb.Service</RootNamespace>
    <!-- the publish folder lives inside the project: keep it out of the content globs -->
    <DefaultItemExcludes>$(DefaultItemExcludes);out/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

</Project>

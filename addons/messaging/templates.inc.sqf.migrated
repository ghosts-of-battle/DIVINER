// AIRDROP BRIEF (deck). RUN-IN HEADING became the ingress/egress pair when
// the handoff redrew it: two fixes on the map say more than a bearing, and
// they carry the departure a heading never did.
[
    "airdrop", "AIRDROP BRIEF", "AIRDROP",
    [
        ["Line 1", "POINT OF IMPACT LOCATION", [
            ["", "Grid / map position", "grid", [["required", true], ["source", "mapClick"]]]
        ]],
        ["Line 2", "POINT OF IMPACT ALTITUDE", [
            ["", "Altitude (m)", "number", [["min", 0], ["max", 5000]]]
        ]],
        ["Line 3", "DZ DESCRIPTION / MARK", [
            ["", "Description, or a marker already on the map", "text", [["source", "marker"]]]
        ]],
        ["Line 4", "FRIENDLIES LOCATION / MARK", [
            ["", "Where the friendlies are, or a marker", "text", [["source", "marker"]]]
        ]],
        ["Line 5", "SURFACE WINDS", [
            ["", "Surface winds", "text"]
        ]],
        ["Line 6", "INGRESS LOCATION", [
            ["", "Ingress point / run-in start", "grid", [["source", "mapClick"], ["noCur", true]]]
        ]],
        ["Line 7", "EGRESS LOCATION", [
            ["", "Egress point / off-target turn", "grid", [["source", "mapClick"], ["noCur", true]]]
        ]],
        ["Remarks", "REMARKS", [
            ["", "Remarks", "textarea"]
        ]]
    ],
    [
        ["anchor", "Line1.A"],
        ["transitionsTo", "ISSUED"],
        ["replyableWith", _replies],
        ["subject", "AIRDROP {Line1.A}"]
    ]
] call FUNC(registerTemplate);

// VEHICLE REPORT / DEFREP (deck). One colour per line. The ROUTING line is the
// carryover from ctab_groups - ticked, it also reaches the command group.
[
    "defrep", "VEHICLE REPORT (DEFREP)", "DEFREP",
    [
        ["Vehicle", "VEHICLE", [
            ["", "Vehicle callsign / type", "text", [["required", true]]]
        ]],
        ["Line 1", "DAMAGE", [
            ["GREEN", "No damage", "bool", [["exclusive", "damage"]]],
            ["YELLOW", "Slight damage, still combat effective", "bool", [["exclusive", "damage"]]],
            ["RED", "Not combat effective", "bool", [["exclusive", "damage"]]],
            ["BLACK", "Destroyed", "bool", [["exclusive", "damage"]]]
        ]],
        ["Line 2", "EQUIPMENT", [
            ["GREEN", "No damage", "bool", [["exclusive", "equipment"]]],
            ["YELLOW", "Slight damage, can carry on with mission", "bool", [["exclusive", "equipment"]]],
            ["RED", "Major damage to equipment", "bool", [["exclusive", "equipment"]]],
            ["BLACK", "No longer mission capable", "bool", [["exclusive", "equipment"]]]
        ]],
        ["Line 3", "FUEL", [
            ["GREEN", "More than 1/2", "bool", [["exclusive", "fuel"]]],
            ["YELLOW", "Less than 1/2", "bool", [["exclusive", "fuel"]]],
            ["RED", "Less than 1/4", "bool", [["exclusive", "fuel"]]],
            ["BLACK", "EMPTY!", "bool", [["exclusive", "fuel"]]]
        ]],
        ["Remarks", "REMARKS", [
            ["", "Remarks", "textarea"]
        ]],
        ["Command", "ROUTING", [
            ["CMD", "Also send to the command group", "bool"]
        ]]
    ],
    [
        ["routing", "Command.A"],
        ["replyableWith", _replies],
        ["subject", "DEFREP {Vehicle.A}"]
    ]
] call FUNC(registerTemplate);

// NO ACE REPORT. It was in the deck and it is deliberately not here: a man's
// A/C/E letters are published onto his unit the moment he presses them in the
// Squad Status app, and the platoon view reads every squad's at once - a filed
// report was a second, staler copy of a state the screens already carry live.
// The design handoff's twelve root reports do not include it.

// REACT/QRF LINK-UP PLAN (deck)
[
    "qrf", "REACT/QRF LINK-UP", "QRF",
    [
        ["Line 1", "WHO LINKS WITH WHO", [
            ["", "Elements linking up", "text", [["required", true]]]
        ]],
        ["Line 2", "LINK-UP LOCATION", [
            ["", "Grid or map marker", "grid", [["required", true], ["source", "mapClick"]]]
        ]],
        ["Line 3", "SUGGESTED ROUTE", [
            ["", "Route to the link-up site", "text"]
        ]],
        ["Line 4", "SPECIAL ATTACHMENTS NEEDED", [
            ["", "Any special attachments needed", "text"]
        ]],
        ["Line 5", "ACTION ON ARRIVAL", [
            ["", "Cordon area, block route, set up CCP, etc.", "text"]
        ]],
        ["Remarks", "REMARKS", [
            ["", "Remarks", "textarea"]
        ]]
    ],
    [
        ["anchor", "Line2.A"],
        ["transitionsTo", "ISSUED"],
        ["replyableWith", _replies],
        ["subject", "QRF LINK-UP {Line2.A} - {Line1.A}"]
    ]
] call FUNC(registerTemplate);

// ---------------------------------------------------------------- replies ---
// Not from the deck. cTab had no threading, so it needed none of these; a
// threaded system that cannot answer a report is a noticeboard.

[
    "roger", "ROGER", "ROGER", [],
    [
        ["kind", "reply"],
        ["transitionsTo", "RECEIPT"],
        ["allowedFrom", ["ISSUED"]]
    ]
] call FUNC(registerTemplate);

[
    "wilco", "WILCO", "WILCO", [],
    [
        ["kind", "reply"],
        ["transitionsTo", "ACCEPTED"],
        ["allowedFrom", ["ISSUED", "RECEIPT"]],
        ["senderMustBe", "assignee"]
    ]
] call FUNC(registerTemplate);

[
    "inprogress", "ON TASK", "ON TASK", [],
    [
        ["kind", "reply"],
        ["transitionsTo", "IN_PROGRESS"],
        ["allowedFrom", ["ACCEPTED", "RECEIPT"]],
        ["senderMustBe", "assignee"]
    ]
] call FUNC(registerTemplate);

[
    "cantco", "CANTCO", "CANTCO",
    [
        ["Reason", "REASON UNABLE TO COMPLY", [
            ["", "Why not", "textarea", [["required", true]]]
        ]]
    ],
    [
        ["kind", "reply"],
        ["priority", "high"],
        ["transitionsTo", "DECLINED"],
        ["allowedFrom", ["ISSUED", "RECEIPT", "ACCEPTED", "IN_PROGRESS"]],
        ["senderMustBe", "assignee"],
        ["subject", "CANTCO - {Reason.A}"]
    ]
] call FUNC(registerTemplate);

[
    "freetext", "MESSAGE", "MSG",
    [
        ["Text", "MESSAGE", [
            ["", "Anything the templates do not cover", "textarea", [["required", true]]]
        ]]
    ],
    [
        ["kind", "both"],
        ["replyableWith", _replies],
        ["subject", "{Text.A}"]
    ]
] call FUNC(registerTemplate);

[
    "close", "CLOSE THREAD", "CLOSE",
    [
        ["Outcome", "OUTCOME", [
            ["", "How it ended", "text"]
        ]]
    ],
    [
        ["kind", "reply"],
        ["transitionsTo", "CLOSED"],
        ["senderMustBe", "issuer"]
    ]
] call FUNC(registerTemplate);

        ["Line 1", "AIRFRAME CALL SIGN", [
            ["", "Call sign", "callsign", [["required", true], ["autoFill", "ownCallsign"]]]
        ]],
        ["Line 2", "NUMBER AND TYPE OF AIRCRAFT", [
            ["", "e.g. 2x AH-99", "text"]
        ]],
        ["Line 3", "POSITION AND ALTITUDE", [
            ["", "Grid / marker / battle position", "grid", [["source", "mapClick"]]],
            ["ALT ", "Altitude (m)", "number", [["min", 0], ["max", 20000]]]
        ]],
        ["Line 4", "ORDNANCE", [
            ["", "Quantity of each munition", "textarea"]
        ]],
        ["Line 5", "TIME ON STATION", [
            ["", "Time available for tasking", "text"]
        ]],
        ["Line 6", "ABORT CODE", [
            ["", "Provided by flight lead", "text"]
        ]],
        ["Line 7", "REMARKS", [
            ["", "Optional", "text"]
        ]]
    ],
    [
        ["anchor", "Line3.A"],
        ["replyableWith", _replies],
        ["subject", "CHECK-IN {Line1.A} - {Line2.A}"]
    ]
] call FUNC(registerTemplate);

